# このファイルを .env.local にコピーし、利用するプロバイダの値のみ設定してください。
#   cp .env.example .env.local
#
# いずれのキーも設定しない場合、開発環境では自動的にモック応答モードで動作します。
# （外部APIを呼ばずにダミー応答を返すため、APIキー無しで画面の確認ができます）

# ---- LLM プロバイダ ----
# OpenAI（GPT系モデル。まず1つだけ試す場合はこれを設定）
OPENAI_API_KEY=

# Anthropic（Claude API を直接利用する場合）
ANTHROPIC_API_KEY=

# Google Gemini
GOOGLE_GENERATIVE_AI_API_KEY=

# AWS Bedrock（UI上の Claude モデルは Bedrock 経由のため、利用する場合は必須）
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=

# ---- 外部検索 ----
# SerpAPI（Web検索Agent を利用する場合のみ必須）
SERP_API_KEY=

# ---- 任意設定 ----
# true にすると、APIキーの有無に関わらず常にモック応答を返します
LLM_USE_MOCK=

# ファイル保存先。未設定時は local（プロジェクト直下の .local-storage/ に保存）
STORAGE_PROVIDER=
STORAGE_LOCAL_ROOT=

# アプリのベースURL。未設定時は http://localhost:3000
NEXTAUTH_URL=

# 開発サーバのポート。未設定時は 3000
PORT=
